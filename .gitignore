node_modules/
dist/
*.log

# ------------------------------------------------------------------
# Lokale Laufzeitdaten — enthalten Geheimnisse und persönliche Daten
# ------------------------------------------------------------------
# config.json enthält u.a. die private ICS-Adresse des Kalenders, den
# Home-Assistant-Token, den OpenAI-Key und das Google-Refresh-Token.
data/config.json

# Kalendercache: enthält die tatsächlichen Termine
data/cache/
data/cache/*.json

# Gestellte Wecker
data/timers.json

# Einkaufsliste und Notizen — persönlicher Laufzeitinhalt
data/lists.json

# Rotierende config.json-Sicherungen (gzip, nicht verschlüsselt) — siehe
# deploy/backup-config.sh
data/backups/

# Die Beispieldatei enthält ausschließlich Platzhalter und gehört ins Repo:
!data/config.example.json
